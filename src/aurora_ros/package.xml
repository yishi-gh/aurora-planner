<?xml version="1.0"?>
<package format="3">
  <name>aurora_ros</name>
  <version>0.1.0</version>
  <description>ROS 2 single-node adapter for AURORA-Planner static and dynamic planning.</description>

  <maintainer email="pathalgo26@todo.todo">PathAlgo26</maintainer>
  <license>GPL-3.0-only</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>aurora_flight_adapter</depend>
  <depend>aurora_map</depend>
  <depend>aurora_math</depend>
  <depend>aurora_msgs</depend>
  <depend>aurora_planner_core</depend>
  <depend>aurora_prediction</depend>
  <depend>aurora_risk</depend>
  <depend>aurora_tracking</depend>
  <depend>aurora_trajectory</depend>
  <depend>eigen3_cmake_module</depend>
  <depend>geometry_msgs</depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_sensor_msgs</depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>aurora_msgs</test_depend>
  <test_depend>launch_testing_ament_cmake</test_depend>
  <test_depend>launch_testing_ros</test_depend>
  <test_depend>rosbag2_py</test_depend>
  <test_depend>rclpy</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
